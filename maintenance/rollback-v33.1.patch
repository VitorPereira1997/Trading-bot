-def _finance_latest(records):
-    latest = {}
-    for r in records:
-        key = r['Conta'].casefold(), r['Moeda']
-        if key not in latest or r['Data'] >= latest[key]['Data']:
-            latest[key] = r
-    return list(latest.values())
